              "unit": "nights"
            },
            {
              "field": "auto_titration_response",
              "operator": "IN",
              "value": [
                "positive response to initial auto titration",
                "negative response to initial auto titration with completed polysomnography test meeting indication 1 or 2"
              ]
            }
          ]
        }
      ],
      "exclusions": []
