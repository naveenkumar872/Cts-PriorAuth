{
  "policy_id": "TRE-79441402",
  "policy_name": "Treatments of Sleep Apnea (Surgical & Non-Surgical)",
  "rule_sets": [
    {
      "rule_set_id": "pap_devices_until_oct_2026",
      "match_criteria": {
        "service_code": {
          "coding_system": "HCPCS",
          "operator": "IN",
          "value": [
            "E0601",
            "E0470",
            "E0471",
            "E0472"
          ]
        }
      },
      "pathways": [
        {
          "pathway_id": "pap_indication_1",
          "logic": "ALL",
          "conditions": [
            {
              "field": "AHI",
              "operator": ">=",
              "value": 15,
              "unit": "events per hour"
            },
            {
              "field": "polysomnography_duration",
              "operator": ">=",
              "value": 2,
              "unit": "hours"
            }
          ]
        },
        {
          "pathway_id": "pap_indication_2",
          "logic": "ALL",
          "conditions": [
            {
              "field": "AHI",
              "operator": ">=",
              "value": 5,
              "unit": "events per hour"
            },
            {
              "field": "AHI",
              "operator": "<=",
              "value": 15,
              "unit": "events per hour"
            },
            {
              "field": "documented_conditions",
              "operator": "IN",
              "value": [
                "excessive daytime sleepiness",
                "impaired cognition",
                "mood disorders",
                "insomnia",
                "hypertension",
                "ischemic heart disease",
                "history of stroke"
              ]
            },
            {
              "field": "polysomnography_duration",
              "operator": ">=",
              "value": 2,
              "unit": "hours"
            }
          ]
        },
        {
          "pathway_id": "pap_indication_3",
          "logic": "ALL",
          "conditions": [
