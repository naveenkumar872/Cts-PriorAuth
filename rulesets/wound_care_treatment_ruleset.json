{
  "policy_id": "WOU-01634634",
  "policy_name": "Wound Care Treatments",
  "rule_sets": [
    {
      "rule_set_id": "skin_substitutes_medically_necessary",
      "match_criteria": {
        "service_code": {
          "coding_system": "HCPCS",
          "operator": "IN",
          "value": [
            "Q4102",
            "Q4104",
            "Q4105",
            "Q4108",
            "Q4110",
            "Q4124",
            "Q4128",
            "Q4137",
            "Q4139",
            "Q4151",
            "Q4168",
            "A2011",
            "A2012",
            "A2013",
            "A4100",
            "Q4224",
            "Q4225",
            "Q4256",
            "Q4257",
            "Q4258"
          ]
        }
      },
      "pathways": [
        {
          "pathway_id": "diabetic_foot_ulcers",
          "logic": "ALL",
          "conditions": [
            {
              "field": "diagnosis",
              "operator": "IN",
              "value": [
                "Diabetes mellitus type 1",
                "Diabetes mellitus type 2"
              ]
            },
            {
              "field": "adequate_blood_supply",
              "operator": "EQUALS",
              "value": "palpable pedal pulse or ankle-brachial index (ABI) >= 0.70"
            },
            {
              "field": "ankle_brachial_index",
              "operator": ">=",
              "value": 0.7
            },
            {
              "field": "conventional_wound_care_and_glycemic_management",
              "operator": "EQUALS",
              "value": "receiving and to continue during treatment"
            },
            {
              "field": "ulcer_type",
              "operator": "EQUALS",
              "value": "Full-thickness foot ulcer"
            },
            {
              "field": "ulcer_location",
              "operator": "IN",
              "value": [
                "plantar",
                "medial",
                "lateral"
              ]
            },
            {
              "field": "exposure_of_tendon_muscle_capsule_bone",
              "operator": "EQUALS",
              "value": false
            },
            {
              "field": "allergy_to_bovine_products",
              "operator": "EQUALS",
              "value": false
            },
            {
              "field": "no_response_to_consistent_conventional_therapy_duration",
              "operator": ">=",
              "value": 4,
              "unit": "weeks"
            },
            {
              "field": "conventional_therapy_includes",
              "operator": "ALL",
              "value": [
                "No weight-bearing (off loading)",
                "Optimal glycemic management",
                "Dressing that promote moist wound healing",
                "Serial debridement as clinically indicated"
              ]
            },
            {
              "field": "wound_infection_growth",
              "operator": "<=",
              "value": "3+ growth on semi-quantitative wound culture"
            },
            {
              "field": "slough_or_eschar_in_wound_bed",
              "operator": "EQUALS",
              "value": false
            },
            {
              "field": "approved_product",
              "operator": "IN",
              "value": [
                "AmnioExcell amniotic allograph",
                "AmnioMatrix amniotic allograft",
                "AmnioExcell plus placental allograph",
                "AlloPatch Pliable Allograft Dermal Matrix",
                "AmnioBand Membrane Allograft Placental Matrix",
                "AmnioBand Particulate Allograft Placental Matrix",
                "AmnioBand Viable Allograft Placental Matrix",
                "Oasis Ultra tri-layer Matrix",
                "Oasis Wound Matrix Fenestrated",
                "Integra Wound Matrix",
                "PriMatrix",
                "PriMatrix Fenestrated",
                "PriMatrix Meshed",
                "PriMatrix Ag",
                "Integra Meshed Dermal Regeneration",
                "Integra Meshed Bilayer Wound Matrix"
              ]
            }
          ],
          "exceptions": [
            {
              "description": "Other causes of neuropathy may be approved on a case by case basis by a medical director"
            }
          ]
        },
        {
          "pathway_id": "venous_insufficiency_ulcers",
          "logic": "ALL",
          "conditions": [
            {
              "field": "diagnosis",
              "operator": "EQUALS",
              "value": "Venous insufficiency ulcer"
            },
            {
              "field": "adequate_blood_supply",
              "operator": "EQUALS",
              "value": "palpable pedal pulse or ankle-brachial index (ABI) >= 0.70"
            },
            {
              "field": "ankle_brachial_index",
              "operator": ">=",
              "value": 0.7
            },
            {
              "field": "concurrent_conventional_wound_care_duration",
              "operator": ">=",
              "value": 4,
              "unit": "weeks"
            },
            {
              "field": "concurrent_conventional_wound_care_includes",
              "operator": "ALL",
              "value": [
                "compression of extremity (e.g. compression stocking, ace bandage, lymphedema pump)"
              ]
            },
            {
              "field": "concurrent_optimal_glycemic_management_if_diabetic",
              "operator": "EQUALS",
              "value": true
            },
            {
              "field": "ulcer_type",
              "operator": "EQUALS",
              "value": "Full-thickness ulcer due to venous insufficiency"
            },
            {
              "field": "allergy_to_bovine_porcine_ovine_products",
              "operator": "EQUALS",
              "value": false
            },
            {
              "field": "no_response_to_conventional_therapy_includes",
              "operator": "ALL",
              "value": [
                "Dressing that promote moist wound healing",
                "Serial debridement as clinically indicated",
                "Compression"
              ]
            },
            {
              "field": "wound_infection_growth",
              "operator": "<=",
              "value": "3+ growth on semi-quantitative wound culture"
            },
            {
              "field": "slough_or_eschar_in_wound_bed",
              "operator": "EQUALS",
              "value": false
            },
            {
              "field": "approved_product",
              "operator": "IN",
              "value": [
                "AmnioExcell amniotic allograph",
                "AmnioMatrix amniotic allograft",
                "AmnioExcell plus placental allograph",
                "AlloPatch Pliable Allograft Dermal Matrix",
                "AmnioBand Membrane Allograft Placental Matrix",
                "AmnioBand Particulate Allograft Placental Matrix",
                "AmnioBand Viable Allograft Placental Matrix",
                "Oasis Ultra tri-layer Matrix",
                "Oasis Wound Matrix Fenestrated",
                "Integra Wound Matrix",
                "PriMatrix",
                "PriMatrix Fenestrated",
                "PriMatrix Meshed",
                "PriMatrix Ag",
                "Integra Meshed Dermal Regeneration",
                "Integra Meshed Bilayer Wound Matrix"
              ]
            }
          ]
        },
        {
          "pathway_id": "medicare_ambulatory_surgery_center",
          "logic": "ALL",
          "conditions": [
            {
              "field": "member_type",
              "operator": "EQUALS",
              "value": "Medicare"
            },
            {
              "field": "place_of_service",
              "operator": "EQUALS",
              "value": "Ambulatory Surgery Center (ASC)"
            },
            {
              "field": "separately_billable",
              "operator": "EQUALS",
              "value": false
            },
            {
              "field": "medical_review_required",
              "operator": "EQUALS",
              "value": false
            }
          ]
        },
        {
          "pathway_id": "medicare_outpatient_hospital_or_clinic",
          "logic": "ALL",
          "conditions": [
            {
              "field": "member_type",
              "operator": "EQUALS",
              "value": "Medicare"
            },
            {
              "field": "place_of_service",
              "operator": "IN",
              "value": [
                "outpatient hospital",
