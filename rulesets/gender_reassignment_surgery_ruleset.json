    {
      "rule_set_id": "mastectomy",
      "match_criteria": {
        "service_name": {
          "operator": "EQUAL",
          "value": "Mastectomy"
        },
        "diagnosis_code": {
          "coding_system": "ICD-10",
          "operator": "IN",
