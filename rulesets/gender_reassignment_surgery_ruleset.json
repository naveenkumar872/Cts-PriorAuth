      },
      "pathways": [
        {
          "pathway_id": "mastectomy_standard_pathway",
          "logic": "ALL",
          "conditions": [
            {
              "field": "assigned_female_at_birth",
              "operator": "EQUAL",
              "value": true
            },
            {
              "field": "age",
              "operator": ">=",
              "value": 18,
              "notes": "Age requirement will not be applied if the surgeon, primary care provider, and qualified mental health professional unanimously document the medical necessity of earlier intervention"
            },
            {
              "field": "single_letter_of_referral_from_qmhp_within_past_18_months",
              "operator": "EQUAL",
              "value": true
            },
            {
              "field": "stable_on_gender_affirming_hormonal_treatment_regime",
              "operator": "EQUAL",
              "value": true,
              "notes": "May include at least 6 months of hormone treatment or longer, unless hormone therapy is not desired or medically contraindicated. Note: trial of hormone therapy is not a pre-requisite."
            },
            {
              "field": "social_transition_undergone_or_planned",
              "operator": "EQUAL",
              "value": true
            }
          ]
        }
      ]
    },
