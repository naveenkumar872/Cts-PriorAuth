    {
      "rule_set_id": "general_requirements_non_medicare",
      "match_criteria": {
        "service_type": {
          "operator": "EQUAL",
          "value": "Gender Affirming Services"
        }
      },
      "pathways": [
        {
          "pathway_id": "general_case_coordination_pathway",
          "logic": "ALL",
          "conditions": [
            {
              "field": "engaged_with_gender_health_case_coordination_program",
              "operator": "EQUAL",
              "value": true
            },
            {
              "field": "referral_reviewed_and_submitted_in_coordination_with_gender_health_case_coordination_team",
              "operator": "EQUAL",
              "value": true,
              "notes": "Not applicable for options patients utilizing out of network benefit, and except for re-authorization requests for expired approvals"
            }
          ]
        },
        {
          "pathway_id": "under_18_surgical_referral_pathway",
          "logic": "ALL",
          "conditions": [
            {
              "field": "age",
              "operator": "<",
              "value": 18
            },
            {
              "field": "care_coordinator_involved",
              "operator": "EQUAL",
              "value": true
            },
            {
              "field": "multidisciplinary_review_completed",
              "operator": "EQUAL",
              "value": true
            }
          ]
        }
      ]
    },
