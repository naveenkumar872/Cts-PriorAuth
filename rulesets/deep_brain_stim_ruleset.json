              "operator": "==",
              "value": "Essential tremor"
            },
            {
              "field": "prior_treatment",
              "operator": "==",
              "value": "Failed maximal medical therapy for controlling tremor"
            },
            {
              "field": "mini_mental_state_examination_score",
              "operator": ">=",
              "value": 24
            },
            {
              "field": "severe_depression",
              "operator": "==",
              "value": "No evidence"
            },
            {
              "field": "clinical_notes_duration",
              "operator": ">=",
              "value": 6,
              "unit": "months"
            }
          ]
        },
        {
          "pathway_id": "parkinsonian_tremor_thalamic_stimulation",
          "logic": "ALL",
          "conditions": [
            {
              "field": "clinical_condition",
              "operator": "==",
              "value": "Parkinsonian tremor"
            },
            {
              "field": "primary_functional_disability",
              "operator": "==",
              "value": "Tremor despite maximal medical therapy"
            },
            {
              "field": "mini_mental_state_examination_score",
              "operator": ">=",
              "value": 24
            },
            {
              "field": "severe_depression",
              "operator": "==",
              "value": "No evidence"
            },
            {
              "field": "clinical_notes_duration",
              "operator": ">=",
              "value": 6,
              "unit": "months"
            }
          ]
        },
        {
          "pathway_id": "parkinsons_symptoms_globus_pallidus_subthalamic_nucleus",
          "logic": "ALL",
          "conditions": [
            {
              "field": "clinical_condition",
              "operator": "==",
              "value": "Parkinson's symptoms"
            },
            {
              "field": "procedure_type",
              "operator": "IN",
              "value": [
                "Globus Pallidus Stimulator Implant",
                "Subthalamic Nucleus Stimulator Implant"
              ]
            },
            {
              "field": "mini_mental_state_examination_score",
              "operator": ">=",
              "value": 24
            },
            {
              "field": "severe_depression",
              "operator": "==",
              "value": "No evidence"
            },
            {
              "field": "clinical_notes_duration",
              "operator": ">=",
              "value": 6,
              "unit": "months"
            }
          ]
        }
      ],
      "exclusions": [
        {
          "condition": "Refractory Obsessive-Compulsive Disorder",
          "reason": "Insufficient evidence in the published medical literature to show that this service/therapy is as safe as standard services/therapies and/or provides better long-term outcomes"
        },
        {
          "condition": "Primary Headache",
          "reason": "Insufficient evidence in the published medical literature to show that this service/therapy is as safe as standard services/therapies and/or provides better long-term outcomes"
        },
        {
          "condition": "Neuropathic Pain",
          "reason": "Insufficient evidence in the published medical literature to show that this service/therapy is as safe as standard services/therapies and/or provides better long-term outcomes"
        }
      ]
