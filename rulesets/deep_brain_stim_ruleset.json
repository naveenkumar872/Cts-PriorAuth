        "member_type": {
          "operator": "==",
          "value": "Non-Medicare"
        },
        "service_code": {
          "coding_system": "CPT",
          "operator": "IN",
          "value": [
            "61863",
            "61864",
            "61867",
            "61868",
            "61880",
            "61885",
            "61886",
            "61888",
            "95970",
            "95983",
            "95984"
          ]
        },
        "hcpcs_code": {
          "coding_system": "HCPCS",
          "operator": "IN",
          "value": [
            "C1820",
            "L8679",
            "L8681",
            "L8686",
            "L8687",
            "L8688",
            "L8689",
            "C1778",
            "C1787",
            "C1816",
            "C1897"
          ]
        }
      },
      "pathways": [
        {
          "pathway_id": "essential_tremor_thalamic_stimulation",
          "logic": "ALL",
          "conditions": [
