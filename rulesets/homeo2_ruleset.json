              "value": "Non-Medicare"
            },
            {
              "field": "clinical_notes_duration",
              "operator": ">=",
              "value": 6,
              "unit": "months",
              "description": "Last 6 months of clinical notes from requesting provider and/or specialist (palliative care, primary care, pulmonary care)"
