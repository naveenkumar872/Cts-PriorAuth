        }
      },
      "pathways": [
        {
          "pathway_id": "gae_for_knee_hemarthrosis",
          "logic": "ALL",
          "conditions": [
            {
              "field": "diagnosis_code",
              "operator": "IN",
              "value": [
                "M25.061",
                "M25.062",
                "M25.069"
              ]
            },
            {
              "field": "prior_event",
              "operator": "EQUAL",
              "value": "following knee surgery"
            },
            {
              "field": "prior_treatment",
              "operator": "EQUAL",
              "value": "failed conservative therapies (which may include some or all of the following: ice, immobilization, compression, saline lavage, corticosteroid instillation, and selective COX-2 inhibitors such as Celecoxib)"
            },
            {
              "field": "diagnostic_finding",
