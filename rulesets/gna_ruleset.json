            "64624",
            "64640"
          ]
        }
      },
      "pathways": [
        {
          "pathway_id": "medicare_coverage_pathway",
          "logic": "OR",
          "conditions": [
            {
              "field": "local_coverage_determination",
              "operator": "EQUAL",
              "value": "Nerve Blockade for Treatment of Chronic Pain and Neuropathy (L35456)"
            },
            {
              "field": "local_coverage_article",
              "operator": "EQUAL",
              "value": "Billing and Coding: Nerve Blockade for Treatment of Chronic Pain and Neuropathy (A56034)"
            },
            {
              "field": "kpwa_medical_policy",
              "operator": "EQUAL",
              "value": "Genicular Nerve Ablation for Knee Osteoarthritis (Non-Medicare criteria) due to absence of NCD, LCD, or other coverage guidance"
            }
          ]
        }
      ],
      "applicable_icd_codes": [
        "M25.561",
        "M25.562"
      ]
    },
    {
      "rule_set_id": "non_medicare_members_genicular_nerve",
      "match_criteria": {
        "member_type": {
          "operator": "EQUAL",
          "value": "Non-Medicare"
        },
        "service_code": {
          "coding_system": "CPT",
          "operator": "IN",
          "value": [
            "64454",
            "64624",
            "64640"
          ]
        }
      },
      "pathways": [
        {
          "pathway_id": "neurolysis_genicular_nerve_mcg",
          "logic": "ALL",
          "conditions": [
            {
              "field": "clinical_guideline",
              "operator": "EQUAL",
              "value": "MCG A-1047"
            }
          ]
        },
        {
          "pathway_id": "thermal_gnrfa_alternative_to_surgery",
          "logic": "ALL",
          "conditions": [
            {
              "field": "procedure_intent",
              "operator": "EQUAL",
              "value": "ablation is being done as an alternative to surgery"
            },
            {
              "field": "review_requirement",
              "operator": "EQUAL",
              "value": "Requires review"
            }
          ]
        }
      ],
      "exclusions": [
        {
          "exclusion_id": "surgical_anesthesia_exception",
          "description": "Genicular nerve ablation done during surgical procedures for anesthesia, such as total knee replacement or ligament and tendon repair, does not require review."
        }
      ]
    },
    {
      "rule_set_id": "genicular_artery_embolization_of_the_knee",
