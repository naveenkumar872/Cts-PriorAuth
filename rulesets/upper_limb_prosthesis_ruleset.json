            "L7259",
            "L8435",
            "L8465",
            "L8485"
          ]
        }
      },
      "pathways": [
        {
          "pathway_id": "standard_myoelectric_criteria",
          "logic": "ALL",
          "conditions": [
            {
              "field": "amputation_or_missing_limb",
              "operator": "EQUAL",
              "value": "present"
            },
            {
              "field": "standard_body_powered_prosthetic_devices_insufficient",
              "operator": "EQUAL",
              "value": "documented in detail by a physical or occupational or physiatrist therapist who is not employed by the vendor or prosthetist"
            },
            {
              "field": "remaining_musculature_microvolt_threshold",
              "operator": "EQUAL",
              "value": "contains the minimum microvolt threshold to allow operation of a myoelectric prosthetic device, as demonstrated by functional testing using a physical or computer model prosthesis"
            },
            {
              "field": "neurological_and_cognitive_function",
              "operator": "EQUAL",
              "value": "sufficient to operate the prosthesis effectively"
            },
            {
              "field": "free_of_comorbidities_interfering_with_function",
              "operator": "EQUAL",
              "value": "true"
            },
            {
              "field": "functional_evaluation_by_qualified_professional",
              "operator": "EQUAL",
              "value": "indicates that with training, use of a myoelectric prosthesis is likely to meet the functional needs of the individual when performing activities of daily living"
            },
            {
              "field": "device_necessary_for_instrumental_activities_of_daily_living",
              "operator": "EQUAL",
              "value": "true"
            },
            {
              "field": "device_not_primarily_for_vocational_leisure_or_recreational_activities",
              "operator": "EQUAL",
              "value": "true"
            },
            {
              "field": "patient_age",
              "operator": ">=",
              "value": 1,
              "unit": "year"
            }
          ]
        }
      ],
      "exclusions": [
        "Prosthesis with individually powered digits, including but not limited to partial hand prosthesis, is considered investigational",
        "Accessory add-ons and upgrades when a basic DME item meets the member’s functional needs",
        "Comfort or convenience items added to basic equipment",
        "Deluxe equipment when basic (standard) equipment is available and meets the member’s functional needs",
        "Duplicate equipment",
        "Equipment and modifications/upgrades to equipment when used primarily for leisure activities (unless plan subject to SHB 1669 Chapter 48.43 RCW)",
        "Same/similar or back-up DME item(s) not used as the primary device to meet the member’s functional needs",
        "Devices that do not meet the definition of durable medical equipment (DME), because they are not primarily intended for medical purposes"
      ]
    },
    {
      "rule_set_id": "repair_and_replacement",
      "match_criteria": {
        "service_type": {
          "operator": "IN",
          "value": [
            "Repair",
            "Replacement"
          ]
        }
      },
      "pathways": [
        {
          "pathway_id": "repair_coverage",
          "logic": "ALL",
          "conditions": [
            {
              "field": "anatomical_change_or_reasonable_wear_and_tear_renders_item_nonfunctional",
              "operator": "EQUAL",
              "value": "true"
            },
            {
              "field": "repair_will_make_equipment_usable",
              "operator": "EQUAL",
              "value": "true"
            }
          ]
        },
        {
          "pathway_id": "replacement_coverage",
          "logic": "ALL",
          "conditions": [
            {
              "field": "anatomical_change_or_reasonable_wear_and_tear_renders_item_nonfunctional",
              "operator": "EQUAL",
              "value": "true"
            },
            {
              "field": "item_is_non_repairable",
              "operator": "EQUAL",
              "value": "true"
            }
          ]
        },
        {
          "pathway_id": "shb_1669_replacement_coverage",
          "logic": "ANY",
          "conditions": [
            {
              "field": "change_in_physiological_condition_of_patient",
              "operator": "EQUAL",
              "value": "true"
            },
            {
              "field": "irreparable_change_in_condition_of_device_or_part",
              "operator": "EQUAL",
              "value": "true"
            },
            {
              "field": "repair_cost_percentage_of_replacement",
              "operator": ">",
              "value": 60,
              "unit": "percent"
            }
          ]
        }
      ],
      "exclusions": [
        "Repair or replacement of an external prosthetic device, including an upper limb myoelectric prosthetic device, made unusable or nonfunctioning because of individual misuse, abuse or neglect is not covered"
      ]
    }
  ],
  "documentation_requirements": [
    {
      "requirement": "Last 6 months of clinical notes from requesting provider &/or specialist",
      "duration": {
        "value": 6,
        "unit": "months"
      }
    },
    {
      "requirement": "An order/prescription from the physician/health care provider responsible for the patient's care that states the therapeutic purpose of the DME"
    },
    {
      "requirement": "The patient's medical condition that requires DME for long term use (i.e. 6-12 months or more) when applicable",
      "duration": {
        "value": 6,
        "unit": "months"
      }
    },
    {
      "requirement": "Details of the patient’s physical functional impairment related to completing activities of daily living (ADLs), or when applicable, essential job related activities and/or exercise (relating to SHB 1669 chapter 48.43 RCW) without the home medical equipment/DME"
    }
  ]
}