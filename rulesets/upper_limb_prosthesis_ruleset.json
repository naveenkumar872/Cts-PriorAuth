            },
            {
              "field": "has_published_hcpcs_code",
              "operator": "EQUAL",
              "value": "true"
            },
            {
              "field": "meets_definition_of_dme",
              "operator": "EQUAL",
              "value": "true"
            },
            {
              "field": "not_considered_not_medically_necessary_investigational_or_unsafe",
              "operator": "EQUAL",
              "value": "true"
            }
          ]
        }
      ],
      "exclusions": [
        "Accessory add-ons and upgrades when a basic DME item meets the member’s functional needs",
        "Comfort or convenience items added to basic equipment",
        "Deluxe equipment when basic (standard) equipment is available and meets the member’s functional needs",
        "Duplicate equipment",
        "Equipment and modifications/upgrades to equipment when used primarily for leisure activities (unless plan subject to SHB 1669 Chapter 48.43 RCW)",
        "Same/similar or back-up DME item(s) not used as the primary device to meet the member’s functional needs",
        "Devices that do not meet the definition of durable medical equipment (DME), because they are not primarily intended for medical purposes"
      ]
    },
    {
      "rule_set_id": "myoelectric_upper_limb_prosthesis",
      "match_criteria": {
        "service_code": {
          "coding_system": "HCPCS",
          "operator": "IN",
          "value": [
            "L6026",
            "L6611",
            "L6677",
