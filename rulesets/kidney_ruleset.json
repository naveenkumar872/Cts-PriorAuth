{
  "policy_id": "KID-98114855",
  "policy_name": "Kidney Transplant Patient Referral Guidelines",
  "rule_sets": [
    {
      "rule_set_id": "kidney_transplant_referral_criteria",
      "match_criteria": {
        "service_code": {
          "coding_system": "CPT",
          "operator": "IN",
          "value": [
            "50300",
            "50320",
            "50323",
            "50325",
            "50327",
            "50328",
            "50329",
            "50340",
            "50360",
            "50365",
            "50370",
            "50380",
            "50547"
          ]
        }
      },
      "pathways": [
        {
          "pathway_id": "standard_kidney_transplant_referral",
          "logic": "OR",
          "conditions": [
            {
              "field": "requires_dialysis",
              "operator": "EQUALS",
              "value": true
            },
            {
              "field": "expected_to_require_dialysis_within_timeframe",
              "operator": "<=",
              "value": 12,
              "unit": "months"
            },
            {
              "field": "estimated_gfr",
              "operator": "<=",
              "value": 30,
              "unit": "mL/min/1.73m2"
            },
            {
              "field": "pediatric_estimated_gfr_schwartz_formula",
              "operator": "BETWEEN",
              "value": [
                10,
                15
              ],
              "unit": "mL/min/1.73m2"
            },
            {
              "field": "pediatric_estimated_gfr_schwartz_formula_symptomatic",
              "operator": "<",
              "value": 10,
              "unit": "mL/min/1.73m2",
              "notes": "Symptomology is defined as poor growth/failure to thrive and suboptimal energy level despite adequate caloric support"
            }
          ]
        },
        {
          "pathway_id": "simultaneous_pancreas_kidney_spk",
          "logic": "ALL",
          "conditions": [
            {
              "field": "diagnosis",
              "operator": "IN",
              "value": [
                "Type 2 diabetes",
                "Type 1.5 diabetes"
              ]
            },
            {
              "field": "bmi",
              "operator": "<",
              "value": 28
            },
            {
              "field": "requires_low_dose_insulin",
              "operator": "EQUALS",
              "value": true
            }
          ]
        },
        {
          "pathway_id": "unos_waiting_list_listing",
          "logic": "ALL",
          "conditions": [
            {
              "field": "estimated_gfr_calculated_by_ckd_epi_creatinine_2021_or_ckd_epi_creatinine_cystatin_2012_refitted_without_race",
              "operator": "<",
              "value": 20,
              "unit": "mL/min"
            }
          ]
        }
      ],
      "general_requirements": [
        {
          "field": "social_support_system",
          "operator": "EQUALS",
          "value": "adequate"
        },
        {
          "field": "adherence_to_medical_treatment",
          "operator": "EQUALS",
          "value": "proven record"
        },
        {
          "field": "substance_abuse_free_duration",
          "operator": ">=",
          "value": 6,
          "unit": "months",
          "notes": "Applies to candidates with a history of substance abuse. Must also be evaluated by a substance abuse program and risk of recidivism must be low. Exceptions on case-by-case basis."
        },
        {
          "field": "travel_willingness_and_ability",
          "operator": "EQUALS",
          "value": "willing and able to travel within short notice to KP approved transplant Center of Excellence and return for treatment of complications"
        },
        {
          "field": "caregiver_availability",
          "operator": "EQUALS",
          "value": "physically and cognitively able to assist with self-care and available to travel within short notice to KP approved transplant Center of Excellence"
        }
      ],
      "exclusions": [
        {
          "exclusion_id": "uncontrollable_active_infection",
          "description": "Uncontrollable active infection is a contraindication to transplant."
        },
        {
          "exclusion_id": "neurologic_psychological_social_nonadherence",
          "description": "Presence of significant irreversible neurologic dysfunction, active psychological and/or psychiatric conditions, and/or other social behaviors that prevent adherence with a complex medical regimen."
        },
        {
          "exclusion_id": "irreversible_cardiovascular_and_pulmonary_disease",
          "description": "Significant irreversible coronary artery disease and/or left ventricular dysfunction, and irreversible pulmonary disease."
        },
        {
          "exclusion_id": "irreversible_peripheral_vascular_disease",
          "description": "Irreversible peripheral vascular disease, including carotid vascular disease. Amputation alone is not a contraindication."
        },
        {
          "exclusion_id": "uncontrolled_hypertension",
          "description": "Uncontrolled hypertension."
        }
      ],
      "relative_contraindications_and_limitations": [
        {
          "field": "history_of_malignancy_moderate_to_high_risk_of_recurrence",
          "description": "May be unsuitable candidates for transplantation. Determined after consultation with oncologist considering tumor type, response to therapy, and presence or absence of metastatic disease."
        },
        {
          "field": "bmi_greater_than_or_equal_to_40",
          "description": "Patients with a BMI >= 40 may be referred to the COE for individual consideration and concurrently referred for weight loss intervention."
        },
        {
          "field": "active_nicotine_abuse",
          "description": "Active nicotine abuse. Specific programs for abdominal organs may require abstinence from tobacco products in order to be actively listed."
        },
        {
          "field": "other_significant_permanent_irreversible_organ_failure",
          "description": "Presence of other significant, permanent, irreversible organ failure."
        }
      ],
      "documentation_requirements": [
        {
          "document_name": "Copy of final summary report from multidisciplinary transplant team",
          "purpose": "To support medical necessity"
        }
      ]
    }
  ]
}